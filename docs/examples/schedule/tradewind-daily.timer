# 17:15 New York on weekdays, daylight saving included (systemd 235 or later reads the zone).
# Holidays: the run finds the last session done and does nothing. Persistent: a run missed
# while the machine was off happens at boot (orders still go before the next open, or are
# proposed only after it).
[Unit]
Description=Tradewind daily paper run after the US close

[Timer]
OnCalendar=Mon..Fri 17:15 America/New_York
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
